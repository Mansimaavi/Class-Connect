# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=5000

# MongoDB (local, Docker, or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/classconnect)
MONGO_URI=mongodb://localhost:27017/classconnect

# JWT secrets: use long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Encrypts users' 2FA secrets at rest (`openssl rand -hex 32`)
TWO_FACTOR_ENCRYPTION_KEY=

# Comma-separated list of allowed frontend origins (CORS + Socket.IO)
CLIENT_URL=http://localhost:5173
# Public URL used in email links (defaults to the first CLIENT_URL)
APP_URL=

# Refresh cookie. Secure defaults to true in production; use SameSite=none only
# when the frontend and API are on different sites.
COOKIE_SECURE=
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the API (nginx, Caddy, load balancer)
TRUST_PROXY=1

# Email. EMAIL_DELIVERY=log prints codes to the console (default when MAIL_HOST is empty outside production).
EMAIL_DELIVERY=
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# File storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=15

# PDF summaries (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LOG_LEVEL=
