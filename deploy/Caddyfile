# Caddy gets and renews a Let's Encrypt certificate for $DOMAIN automatically.
# Without a domain of your own, <elastic-ip>.sslip.io works (it resolves to that IP).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy web:80
}
